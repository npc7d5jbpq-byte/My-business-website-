# Copy this file to .env and adjust as needed.

# Port the server listens on
PORT=3000

# Login credentials for the office system
# Quoted because the password contains a # character, which dotenv would
# otherwise treat as the start of a comment.
ADMIN_USERNAME="Gulberg City Office"
ADMIN_PASSWORD="Maliha1234@#$"

# Random long string used to sign session cookies. Change this in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "true" only when serving the site over HTTPS
COOKIE_SECURE=false
