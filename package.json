{
  "name": "gulberg-city-office-erp",
  "version": "1.0.0",
  "description": "Real estate record-keeping desktop app for Gulberg City Office - colonies, plots, agricultural land, shops and commercial land/plot tracking with full payment ledgers.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.4"
  },
  "author": "Gulberg City Office",
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.gulbergcityoffice.erp",
    "productName": "Gulberg City Office",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "electron/**/*",
      "server.js",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!data/**",
      "!.env"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
